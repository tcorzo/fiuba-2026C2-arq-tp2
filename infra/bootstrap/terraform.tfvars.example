# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: never commit it.
# These values end up as sensitive variables of the HCP Terraform workspaces.

# Subscription ID shown after `az login`
azure_sid = "<Subscription ID de Azure>"

# Docker Hub account and a Public Repo Read-only access token
dockerhub_username = "<Nombre de usuario>"
dockerhub_token    = "<Token>"
