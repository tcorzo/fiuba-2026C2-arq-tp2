{
  "title": "arVault load test",
  "description": "Managed by Terraform (infra/envs/prd/observability): edits made here are overwritten on the next apply. Client side (Artillery, tagged test:<scenario>) next to the VMSS nodes (Datadog agent) and the service's own metrics (arvault.*, tagged by host, route, status, outcome). Set the time range to the run's before taking a screenshot, and export this JSON with it.",
  "layout_type": "ordered",
  "template_variables": [
    {
      "name": "test",
      "prefix": "test",
      "available_values": [],
      "default": "baseline"
    },
    {
      "name": "host",
      "prefix": "host",
      "available_values": [],
      "default": "*"
    }
  ],
  "widgets": [
    {
      "definition": {
        "type": "group",
        "title": "Client (Artillery), filtered by $test",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Offered and served load (per second)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "arrivals",
                      "query": "sum:artillery.vusers.created{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "responses",
                      "query": "sum:artillery.http.responses{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "failed",
                      "query": "sum:artillery.vusers.failed{$test}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "arrivals",
                      "alias": "arrivals/s (offered)"
                    },
                    {
                      "formula": "responses",
                      "alias": "responses/s (served)"
                    },
                    {
                      "formula": "failed",
                      "alias": "failed users/s"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Responses and errors per second, by status",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "c200",
                      "query": "sum:artillery.http.codes.200{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c403",
                      "query": "sum:artillery.http.codes.403{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c409",
                      "query": "sum:artillery.http.codes.409{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c500",
                      "query": "sum:artillery.http.codes.500{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "c502",
                      "query": "sum:artillery.http.codes.502{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "etimedout",
                      "query": "sum:artillery.errors.ETIMEDOUT{$test}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "econnreset",
                      "query": "sum:artillery.errors.ECONNRESET{$test}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "c200",
                      "alias": "200/s"
                    },
                    {
                      "formula": "c403",
                      "alias": "403/s ARCA rejected"
                    },
                    {
                      "formula": "c409",
                      "alias": "409/s insufficient funds"
                    },
                    {
                      "formula": "c500",
                      "alias": "500/s"
                    },
                    {
                      "formula": "c502",
                      "alias": "502/s ARCA or deposit"
                    },
                    {
                      "formula": "etimedout",
                      "alias": "ETIMEDOUT/s"
                    },
                    {
                      "formula": "econnreset",
                      "alias": "ECONNRESET/s"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Response time, all routes (ms)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "p50",
                      "query": "avg:artillery.http.response_time.median{$test}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p95",
                      "query": "avg:artillery.http.response_time.p95{$test}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "p99",
                      "query": "avg:artillery.http.response_time.p99{$test}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "p50",
                      "alias": "median"
                    },
                    {
                      "formula": "p95",
                      "alias": "p95"
                    },
                    {
                      "formula": "p99",
                      "alias": "p99"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "VMSS nodes (Datadog agent), filtered by $host",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU user + system by node (%)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "user",
                      "query": "avg:system.cpu.user{$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "sys",
                      "query": "avg:system.cpu.system{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "user + sys",
                      "alias": "user + system"
                    }
                  ]
                }
              ],
              "yaxis": {
                "min": "0",
                "max": "100"
              }
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "CPU steal and iowait by node (%)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "steal",
                      "query": "avg:system.cpu.stolen{$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "iowait",
                      "query": "avg:system.cpu.iowait{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "steal",
                      "alias": "steal"
                    },
                    {
                      "formula": "iowait",
                      "alias": "iowait"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Load average (1 min) by node",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "load",
                      "query": "avg:system.load.1{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "load"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Network by node (bytes/s)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "rx",
                      "query": "sum:system.net.bytes_rcvd{$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "tx",
                      "query": "sum:system.net.bytes_sent{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "rx",
                      "alias": "received"
                    },
                    {
                      "formula": "tx",
                      "alias": "sent"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Memory used by node (bytes)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "mem",
                      "query": "avg:system.mem.used{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "mem"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "type": "group",
        "title": "Service (arvault.*, from the app through DogStatsD), filtered by $host",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "timeseries",
              "title": "Server-side duration by route, p50 (ms)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h50",
                      "query": "p50:arvault.http.duration{$host} by {route}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h50"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Server-side duration by route, p95 (ms)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "h95",
                      "query": "p95:arvault.http.duration{$host} by {route}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "h95"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Responses per second by route and status",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "r",
                      "query": "sum:arvault.http.responses{$host} by {route,status}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "r"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "ARCA validation and exchange duration (ms)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "a50",
                      "query": "p50:arvault.arca.validation.duration{$host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "a95",
                      "query": "p95:arvault.arca.validation.duration{$host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "e50",
                      "query": "p50:arvault.exchange.processing.duration{$host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "e95",
                      "query": "p95:arvault.exchange.processing.duration{$host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "a50",
                      "alias": "arca.validation p50"
                    },
                    {
                      "formula": "a95",
                      "alias": "arca.validation p95"
                    },
                    {
                      "formula": "e50",
                      "alias": "exchange (without ARCA) p50"
                    },
                    {
                      "formula": "e95",
                      "alias": "exchange (without ARCA) p95"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "ARCA validations per second, by outcome",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "v",
                      "query": "sum:arvault.arca.validation.outcomes{$host} by {outcome}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "v"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Exchanges per second, by outcome and failure cause",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "o",
                      "query": "sum:arvault.exchange.outcomes{$host} by {outcome}.as_rate()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "x",
                      "query": "sum:arvault.exchange.failures{$host} by {cause}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "o"
                    },
                    {
                      "formula": "x"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Handled errors per second, by code",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "bars",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "e",
                      "query": "sum:arvault.http.errors{$host} by {code}.as_rate()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "e"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Event loop lag by node (ms)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "l99",
                      "query": "avg:arvault.runtime.eventloop.lag.p99{$host} by {host}"
                    },
                    {
                      "data_source": "metrics",
                      "name": "lmax",
                      "query": "max:arvault.runtime.eventloop.lag.max{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "l99",
                      "alias": "p99"
                    },
                    {
                      "formula": "lmax",
                      "alias": "max"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Process RSS by node (bytes)",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "rss",
                      "query": "avg:arvault.runtime.heap.rss{$host} by {host}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "rss"
                    }
                  ]
                }
              ]
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Internal account balances, by currency",
              "show_legend": true,
              "requests": [
                {
                  "response_format": "timeseries",
                  "display_type": "line",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "b",
                      "query": "avg:arvault.accounts.balance{$host} by {currency}"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "b"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
