#  Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# .tfvars files
*.tfvars

# Node
node_modules/

# Rendered report. The PDF is a build product of `mise run report`, so during
# the TP it stays out of git: tracking it turns every edit into a binary
# conflict. The assignment wants it in the repo at delivery: the delivery PR
# adds it with `git add -f docs/informe/informe.pdf`.
docs/informe/informe.pdf

# Per-developer tooling overrides. mise reads these on top of mise.toml;
# committing one silently changes everyone else's toolchain.
mise.local.toml
.mise.local.toml
.claude/settings.local.json

# Session orientation artifacts generated by local hooks. Not shared.
/WIP.md
/CONVERSATION-LOG.md

# Logs, editors and OS
*.log
.idea/
*.swp
*~
.DS_Store

# Deliberately tracked — do not add rules for these:
# perf/results/  The raw Artillery reports. The assignment requires them in
#                the repo, next to the scenario that produced them.
# evidencia/     Terraform, az and log outputs cited as [E-NN] in the report.


